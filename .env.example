# LinkedIn Corp MCP Configuration (Company Page / organization tools)

PORT=8000
LOG_LEVEL=INFO

# OAuth client (same LinkedIn app as linkedin-mcp, different scopes)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8001/oauth/callback

# Default org scopes (Community Management API)
# LINKEDIN_CORP_OAUTH_SCOPES=openid profile email r_organization_social w_organization_social rw_organization_admin

# Optional LinkedIn-Version header (YYYYMM)
# LINKEDIN_CORP_API_VERSION=202401

LINKEDIN_CORP_MAX_IMAGE_BYTES=8388608
LINKEDIN_CORP_MAX_TEXT_CHARS=3000
LINKEDIN_CORP_HTTP_TIMEOUT_SEC=30

# Local OAuth/test UI (default off). Use port 8001 if linkedin-mcp uses 8000.
LINKEDIN_CORP_ENABLE_OAUTH_UI=0

# LINKEDIN_CORP_CREDENTIALS_DIR=/var/linkedin-corp-credentials

LINKEDIN_CORP_CREATE_RATE_LIMIT=10
LINKEDIN_CORP_CREATE_RATE_WINDOW_SEC=3600

# Optional Tool Registry
# TOOL_REGISTRY_BASE_URL=http://datumbridge-mcp:8081/api/v1
# TOOL_REGISTRY_API_KEY=
